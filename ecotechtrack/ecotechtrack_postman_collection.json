									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos"]
						}
					},
					"response": []
				},
				{
					"name": "2.2 Obtener residuo por ID (GET)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
