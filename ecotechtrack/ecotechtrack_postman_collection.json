						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos/1/historial",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "1", "historial"]
						}
					},
					"response": []
				},
				{
					"name": "2.4 Registrar nuevo residuo (POST)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
