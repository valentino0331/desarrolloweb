{
	"info": {
		"_postman_id": "ecotechtrack-api-v3-security-jpql",
		"name": "EcoTechTrack - API REST Trazabilidad RAEE (APF2: Seguridad JWT & JPQL)",
		"description": "Colección completa de pruebas para EcoTechTrack (Spring Boot 3 + Spring Security + JWT + JPQL). Incluye autenticación con JWT, roles RBAC (ADMIN, OPERADOR, USER), filtros JPQL avanzados y CRUD asegurado.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwtToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Autenticación y JWT (Spring Security)",
			"item": [
				{
					"name": "0.1 Iniciar Sesión - ADMIN (Captura Token Automático)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
									"    console.log(\"Token JWT guardado exitosamente: \" + jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					},
					"response": []
				},
				{
					"name": "0.2 Iniciar Sesión - OPERADOR",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"operador\",\n  \"password\": \"Operador123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					},
					"response": []
				},
				{
					"name": "0.3 Iniciar Sesión - USUARIO CONSULTOR",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"usuario\",\n  \"password\": \"User123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					},
					"response": []
				},
				{
					"name": "0.4 Registrar Nuevo Usuario (/api/auth/register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"inspector_ambiental\",\n  \"password\": \"Inspector2026!\",\n  \"nombreCompleto\": \"Lic. Juan Mendoza\",\n  \"email\": \"inspector@ecotechtrack.pe\",\n  \"roles\": [\"ROLE_USER\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
					},
					"response": []
				},
				{
					"name": "0.5 Consultar Perfil Actual (/api/auth/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "1. Consultas JPQL Personalizadas (Requisito APF2)",
			"item": [
				{
					"name": "1.1 JPQL: Filtrar por Rango de Fechas",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos/jpql/fechas?inicio=2026-01-01T00:00:00&fin=2026-12-31T23:59:59",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "jpql", "fechas"],
							"query": [
								{
									"key": "inicio",
									"value": "2026-01-01T00:00:00"
								},
								{
									"key": "fin",
									"value": "2026-12-31T23:59:59"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "1.2 JPQL: Búsqueda Multicriterio Avanzada",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos/jpql/busqueda-avanzada?estado=DECLARADO_BAJA&categoria=EQUIPOS_INFORMATICA_Y_TELECOMUNICACIONES&termino=ProLiant",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "jpql", "busqueda-avanzada"],
							"query": [
								{
									"key": "estado",
									"value": "DECLARADO_BAJA"
								},
								{
									"key": "categoria",
									"value": "EQUIPOS_INFORMATICA_Y_TELECOMUNICACIONES"
								},
								{
									"key": "termino",
									"value": "ProLiant"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "1.3 JPQL: Métricas Estadísticas por Estado (Agregación)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos/jpql/estadisticas",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "jpql", "estadisticas"]
						}
					},
					"response": []
				},
				{
					"name": "1.4 JPQL: Residuos Pesados en Almacén",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos/jpql/almacen/1/pesados?pesoMinimo=20.0",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "jpql", "almacen", "1", "pesados"],
							"query": [
								{
									"key": "pesoMinimo",
									"value": "20.0"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Gestión de Residuos RAEE (Asegurados)",
			"item": [
				{
					"name": "2.1 Listar todos los residuos (GET)",
					"request": {
