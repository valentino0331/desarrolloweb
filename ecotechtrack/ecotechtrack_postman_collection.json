						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigoIdentificacion\": \"RAEE-2026-POSTMAN\",\n  \"descripcion\": \"Lote de Switches Cisco Catalyst 2960 (4 unidades)\",\n  \"categoria\": \"EQUIPOS_INFORMATICA_Y_TELECOMUNICACIONES\",\n  \"marca\": \"Cisco\",\n  \"modelo\": \"Catalyst 2960-X\",\n  \"numeroSerie\": \"LOTE-CS-2960-2026\",\n  \"pesoKg\": 18.5,\n  \"estado\": \"DECLARADO_BAJA\",\n  \"almacenId\": 1,\n  \"empresaGestoraId\": null,\n  \"observaciones\": \"Baja técnica por migración a fibra óptica de 10Gbps\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/residuos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos"]
						}
					},
					"response": []
				},
				{
					"name": "2.5 Cambiar estado en la trazabilidad (PATCH)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nuevoEstado\": \"ALMACENADO_TEMPORAL\",\n  \"responsable\": \"Operador de Acopio\",\n  \"observaciones\": \"Ingreso verificado físicamente y rotulado con QR\",\n  \"almacenId\": 2,\n  \"empresaGestoraId\": null\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/residuos/1/estado",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "1", "estado"]
						}
					},
					"response": []
				},
				{
					"name": "2.6 Eliminar residuo - Solo ADMIN (DELETE)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/residuos/4",
							"host": ["{{baseUrl}}"],
							"path": ["api", "residuos", "4"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Pruebas de Seguridad y Errores (RBAC & 401/403)",
			"item": [
